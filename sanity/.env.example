# Copy this file to sanity/.env.local and fill in your real values.
# The studio dev server (npm run studio) runs from the sanity/ folder, so it
# reads env files from here — not from the root .env.local.
# Sanity Studio only exposes SANITY_STUDIO_* variables to the browser.

SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
